// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "agent_ui_font_size": 17.0,
  "ui_font_weight": 500.0,
  "lsp_document_colors": "background",
  "terminal": {
    "font_size": 17.0,
  },
  "ui_font_family": "Whitney SSm M",
  "buffer_font_weight": 500.0,
  "buffer_font_family": "MonoLisa",
  "cursor_blink": false,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions"
      },
      "type": "registry",
    },
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 17.0,
  "buffer_font_size": 17.0,
  "agent_buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn (WebStorm)",
    "dark": "Gruvbox Dark Hard",
  },
  "code_actions_on_format": {
    "source.organizeImports": true,
    "source.fixAll": true,
    "source.fixAll.eslint": true,
  },
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "!eslint"],
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
      "format_on_save": "on",
    },
    "TSX": {
      "language_servers": ["vtsls", "!eslint"],
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "none",
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 4096,
          },
        },
      },
    },
  },
}
