# ~/.zshrc.work.example  →  copy to ~/.zshrc.work (which is gitignored) and fill in.
# This is where Copper/Linqed-specific config lives so it stays OUT of the committed dotfiles.
# RULE: never hardcode secrets here. Pull them from 1Password at shell start (see below).

# --- Paths (new machine layout) ---
COPPER="$HOME/Developer/Work/Copper/copper"
LINQED="$HOME/Developer/Work/Linqed"

# --- AWS (point at the work repo's profile/config once cloned) ---
export AWS_SHARED_CREDENTIALS_FILE="$COPPER/.aws/credentials"
export AWS_CONFIG_FILE="$COPPER/.aws/config"
export AWS_SDK_LOAD_CONFIG=true

# Copper requires amd64 emulation for its Docker images
export DOCKER_DEFAULT_PLATFORM=linux/amd64

# mysql-client@8.0 is keg-only — put mysql/mysqldump on PATH (Copper DB work)
export PATH="/opt/homebrew/opt/mysql-client@8.0/bin:$PATH"

# --- Secrets via 1Password CLI (op) — NOT hardcoded. Requires `op` + signin. ---
# The old Datadog key was hardcoded and leaked into git history → it's been rotated; store the new one
# in 1Password and reference it here with your real op:// path. (App Center was retired.)
# export DD_API_KEY="$(op read 'op://Work/<datadog-item>/api_key' 2>/dev/null)"

# --- Nav aliases (new ~/Developer/Work layout) ---
alias copper="cd $COPPER"
alias app="cd $COPPER/packages/app"
alias web="cd $COPPER/packages/web"
alias admin="cd $COPPER/packages/admin"
alias gateway="cd $COPPER/packages/gateway"
alias daze="cd $LINQED/daze"
alias dapp="cd $LINQED/daze/packages/app"

# --- cu (Copper CLI) ---
cu() { "$COPPER/packages/cucmd/bin/run" "$@"; }

# --- Dev workflow (daily drivers) ---
alias copper-dev="$COPPER/scripts/dev-iterm.sh"
alias copper-dev-admin="$COPPER/scripts/dev-iterm-admin.sh"

# cu autocomplete (path is created by cu after first run)
CU_AC_ZSH_SETUP_PATH="$HOME/Library/Caches/@copperapp/cucmd/autocomplete/zsh_setup"
[ -f "$CU_AC_ZSH_SETUP_PATH" ] && source "$CU_AC_ZSH_SETUP_PATH"
[ -f "$HOME/Library/Caches/@copperapp/cucmd/copper_aliases" ] && \
  source "$HOME/Library/Caches/@copperapp/cucmd/copper_aliases"

# --- review <PR#>: check out a Copper PR in a dedicated worktree and open in Zed ---
review() {
  [ -z "$1" ] && { echo "Usage: review <PR_NUMBER>"; return 1; }
  local worktree="$HOME/Developer/Work/Copper/copper-review"
  # Bootstrap the worktree on first use (e.g. a new machine) — same as parallel().
  if [ ! -d "$worktree" ]; then
    echo "Creating review worktree at $worktree..."
    git -C "$COPPER" fetch origin master || return 1
    git -C "$COPPER" worktree add --detach "$worktree" origin/master || return 1
  fi
  cd "$worktree" && gh pr checkout "$1" && yarn install && zed -n .
}

# --- parallel <branch>: spin up a parallel Copper worktree off origin/master ---
parallel() {
  [ -z "$1" ] && { echo "Usage: parallel <branch-name>"; return 1; }
  local branch="$1"
  local repo="$COPPER"
  local worktree="$HOME/Developer/Work/Copper/copper-parallel"
  cd "$repo" || return 1
  git fetch origin master || return 1
  if git worktree list --porcelain | grep -q "^worktree $worktree$"; then
    if [ -n "$(git -C "$worktree" status --porcelain)" ]; then
      echo "Parallel worktree has uncommitted changes. Commit or stash there first."; return 1
    fi
    git worktree remove "$worktree" || return 1
  fi
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$worktree" "$branch" || return 1
  else
    git worktree add -b "$branch" "$worktree" origin/master || return 1
  fi
  cd "$worktree" && yarn install && zed -n .
}
